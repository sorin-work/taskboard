# Copy to .env (next to docker-compose.yml) to override the defaults.

# Host ports
DB_PORT=5444
API_PORT=4404
WEB_PORT=5184

# Signs login tokens. Use a long random string anywhere but your laptop.
JWT_SECRET=local-development-secret-change-me-0123456789

# Create demo@example.com / demo-password with sample data on start.
SEED_DEMO=true
